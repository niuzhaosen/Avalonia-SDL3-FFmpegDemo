<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Demo.MainWindow"
		MinHeight="450" MinWidth="800"
        Title="Demo">
	<DockPanel>

		<Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,10,0,10" DockPanel.Dock="Bottom">
			<StackPanel>
				<TextBox HorizontalAlignment="Center" Width="600" Name="RtspAddress"></TextBox>
				<Button HorizontalAlignment="Center" Name="PlayBtn">播放</Button>
			</StackPanel>
		</Border>

		<UniformGrid Rows="1" Columns="2">
			<Grid Margin="4">
				<TextBlock>FFmpeg</TextBlock>
				<Image Name="Img1">


				</Image>
			</Grid>
			<Grid Margin="4">
				<TextBlock>RtspClientSharp+FFmpeg</TextBlock>
				<Image Name="Img2"></Image>
			</Grid>

		</UniformGrid>

	</DockPanel>
</Window>
